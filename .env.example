# Скопируй этот файл: cp .env.example .env

# PostgreSQL (должно совпадать с docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=chat_user
DB_PASSWORD=chat_password
DB_NAME=chat_db

# Сервер
SERVER_PORT=8080

# JWT — смени на случайную строку в продакшене!
JWT_SECRET=change-me-to-random-secret-key
